node_modules/
dist/
test-results/
playwright-report/
*.local
.claude/
dist-single

# Throwaway scripts for driving a browser while reviewing something. A dot
# prefix keeps them out of `git add -A`, which is how one of them got committed.
scripts/.*

# Throwaway browser-check scripts, run from the project root so they can
# resolve @playwright/test. Never part of the project.
#
# Two spellings because one rule only catches the name somebody remembers to
# use: `cc-end.mjs` was none of these and shipped to production sitting in the
# root, and the stop hook has since caught `shot-tmp.mjs` and `probe-tmp.mjs`.
# Anything written to look at something and then thrown away belongs here.
*-shot.mjs
*-tmp.mjs
# And what those scripts photograph, which lands beside them.
/*.png
artifact-out
dist-survive
dist-spin
dist-charge
board-out/
